# ── Telegram ─────────────────────────────────────────────────────────────
# Токен от @BotFather. Можно взять токен от tg-transcribe-bot, но тогда
# старый бот надо остановить (два процесса на один токен не работают).
BOT_TOKEN=
# Твой Telegram user id (узнать: /id в боте или @userinfobot). Через запятую.
ALLOWED_IDS=
# Куда слать утренний бриф и вечерний чек-ин. Если пусто — первый из ALLOWED_IDS.
CHAT_ID=
# SOCKS5/HTTP прокси для Telegram, если нужен (как в tg-transcribe-bot). Пусто = без прокси.
PROXY_URL=

# ── Время ────────────────────────────────────────────────────────────────
TZ_NAME=Asia/Novosibirsk
MORNING_TIME=08:00
BREAKFAST_CHECK_TIME=11:00
EVENING_TIME=21:30
# Утренний обзор календаря и задач. Это единственное сообщение по расписанию по умолчанию.
MORNING_BRIEF_ENABLED=true
# Старые проверки завтрака и вечернего настроения. Для простого календарного бота выключены.
HEALTH_CHECKINS_ENABLED=false
WAKE_TARGET=07:30
SLEEP_TARGET_HOURS=7.5

# ── Мозг бота: OpenAI, Gemini или Claude ─────────────────────────────────
# auto = первый, у кого есть ключ, в порядке OpenAI → Gemini → Claude.
# Можно указать явно: openai | gemini | anthropic
LLM_PROVIDER=auto
# Прокси для вызовов LLM (из России API OpenAI/Google/Anthropic без прокси недоступны).
# Пусто = берётся PROXY_URL от Telegram. Формат: socks5://user:pass@host:port или http://host:port
LLM_PROXY_URL=

# OpenAI: ключ с platform.openai.com → API keys, пополнить баланс от $5.
# Подписка ChatGPT / Codex к API не относится, токены Codex в своих ботах использовать нельзя.
OPENAI_API_KEY=
# gpt-5-mini — оптимум по цене/качеству; gpt-5-nano — ещё дешевле; gpt-5 — умнее и дороже.
OPENAI_MODEL=gpt-5-mini
# Глубина размышлений gpt-5*: minimal | low | medium | high. Для разбора сообщений хватает low.
OPENAI_REASONING=low

# Gemini: ключ бесплатно в aistudio.google.com → Get API key (подписка Gemini/Google AI Pro тут не при чём).
# ВАЖНО: на бесплатном тарифе Google использует запросы для обучения и их могут читать люди.
# Для данных о здоровье лучше включить биллинг (предоплата от $5) — тогда данные не используются.
GEMINI_API_KEY=
# gemini-3.8-flash — умный и есть в бесплатном тарифе; gemini-3.5-flash-lite — ещё дешевле и быстрее.
GEMINI_MODEL=gemini-3.8-flash
# Глубина размышлений для Gemini 3.x: low | medium | high. Для разбора сообщений хватает low.
GEMINI_THINKING=low

# Claude: ключ из console.anthropic.com (отдельно от подписки Max, нужно пополнить баланс).
ANTHROPIC_API_KEY=
# claude-sonnet-5 — оптимум; claude-opus-5 — умнее и дороже; claude-haiku-4-5-20251001 — самый дешёвый.
CLAUDE_MODEL=claude-sonnet-5

# Без ключей бот работает в «тупом» режиме: сохраняет записи как заметки, шлёт брифы по правилам.
# Добавлять ли 2–3 предложения от LLM в утренний бриф (+1 вызов в день).
LLM_PROSE_IN_BRIEF=true

# ── База знаний (методология планирования + профиль) ─────────────────────
# Папка с *.md, которые целиком идут в системный промпт. Заполни knowledge/about_me.md!
KNOWLEDGE_DIR=./knowledge

# ── Распознавание голоса (локально, faster-whisper) ──────────────────────
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru

# ── Google Calendar (сервисный аккаунт + расшаренный календарь) ──────────
# Бесплатный простой вариант через Google Apps Script (без карты):
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Первый календарь — куда бот создаёт события; читать будет все перечисленные.
GOOGLE_CALENDAR_IDS=

# Запасной вариант через сервисный аккаунт:
# 1) console.cloud.google.com → проект → включить Google Calendar API
# 2) IAM → Service Accounts → создать → Keys → JSON → сохранить сюда
# 3) В Google Календаре: настройки календаря → «Доступ для отдельных пользователей»
#    → добавить email сервисного аккаунта с правом «Внесение изменений в мероприятия»
GOOGLE_SA_FILE=./data/google-sa.json
# id календаря = твой gmail (не "primary"!)
GOOGLE_CALENDAR_ID=

# ── cal.com (встречи, которые бронируют другие) ──────────────────────────
# app.cal.com → Settings → Developer → API keys
CALCOM_API_KEY=
CALCOM_API_VERSION=2024-08-13

# ── Todoist ──────────────────────────────────────────────────────────────
# Todoist → Settings → Integrations → Developer → API token
TODOIST_TOKEN=

# ── Хранилище ────────────────────────────────────────────────────────────
DB_PATH=./data/assistant.sqlite3
